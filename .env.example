EVIDENCEFLOW_APP_NAME=EvidenceFlow AI
EVIDENCEFLOW_ENV=development
EVIDENCEFLOW_DEBUG=false
EVIDENCEFLOW_LOG_LEVEL=INFO
EVIDENCEFLOW_MAX_UPLOAD_MB=25
EVIDENCEFLOW_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EVIDENCEFLOW_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EVIDENCEFLOW_RERANKER_ENABLED=false
# EVIDENCEFLOW_DATA_DIR=/absolute/path/to/data
# EVIDENCEFLOW_ARTIFACTS_DIR=/absolute/path/to/artifacts
# EVIDENCEFLOW_DATABASE_PATH=/absolute/path/to/evidenceflow.db
